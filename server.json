{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mayank1307/gitferry",
  "title": "GitFerry",
  "description": "Pack, inspect, and apply portable Git change bundles across offline repositories.",
  "repository": {
    "url": "https://github.com/mayank1307/gitferry",
    "source": "github"
  },
  "version": "0.4.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "gitferry",
      "version": "0.4.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
